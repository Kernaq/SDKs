# Kernaq Identity SDK — configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it contains your API key.

# Your API key from https://kernaq.com/dashboard
# k_test_... for sandbox  |  k_live_... for production
KERNAQ_API_KEY=k_test_your_key_here

# Identity API base URL — only change this for local dev or self-hosted
KERNAQ_API_URL=https://api.kernaq.com/v1
